---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p class="lede">
      {description}
    </p>
  </div>
</header>
<style>
  .page-header {
    padding: clamp(3.5rem, 8vw, 6.5rem) 0 3.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .page-header h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    max-width: 16ch;
  }
  .page-header .lede {
    margin-top: 1.25rem;
  }
</style>
