---
import type { Locale, Project } from "@/types";
import { local, localePath } from "@/i18n";
import { projectVisuals, visualAssets } from "@/data/visualAssets";
import CollageImage from "@/components/visual/CollageImage.astro";
interface Props { project: Project; locale: Locale; highlight?: boolean; }
const { project, locale, highlight = project.slug === "campus-agent" } = Astro.props;
const visualKey = projectVisuals[project.slug];
const collageAsset = visualKey ? visualAssets[visualKey] : undefined;
const detailUrl = localePath(locale, `projects/${project.slug}`);
---

<article
  class:list={["project-card", "card", highlight && "is-highlight", collageAsset && "has-collage"]}
  data-type={project.type}
  data-search={`${local(project.title, locale)} ${local(project.summary, locale)} ${project.tags.join(" ")}`.toLowerCase()}
>
  <a class="cover" href={detailUrl} tabindex="-1" aria-hidden="true">
    {collageAsset ? (
      <CollageImage asset={collageAsset} {locale} animation="none" widths={[420, 720, 960]} sizes={highlight ? "(max-width: 700px) 94vw, 44vw" : "(max-width: 700px) 94vw, 42vw"} />
    ) : (
      <img src={`${import.meta.env.BASE_URL}${project.cover.replace(/^\//, "")}`} width="720" height="430" loading="lazy" decoding="async" alt="" />
    )}
  </a>
  <div class="content">
    <div class="meta"><span>{project.type}</span><span>{project.year}</span></div>
    <h3><a href={detailUrl}>{local(project.title, locale)}<span class="project-arrow" aria-hidden="true">↗</span></a></h3>
    <p>{local(project.summary, locale)}</p>
    <div class="tags">{project.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div>
    {(project.links.github || project.links.demo) && (
      <div class="quick-links">
        {project.links.github && <a href={project.links.github}>Code</a>}
        {project.links.demo && <a href={project.links.demo}>Demo</a>}
      </div>
    )}
  </div>
</article>

<style>
  .project-card { position:relative; grid-column:span 6; overflow:hidden; transition:transform var(--motion-fast),border-color var(--motion-fast); }
  .project-card:hover { transform:translateY(-3px); border-color:var(--color-accent); }
  .project-card.is-highlight { grid-column:1/-1; display:grid; grid-template-columns:minmax(0,1.08fr) minmax(300px,.92fr); min-height:360px; }
  .cover { display:block; aspect-ratio:16/8.8; overflow:hidden; background:var(--color-muted); }
  .cover :global(img) { width:100%; height:100%; object-fit:cover; transition:transform var(--motion-normal) var(--ease-spring-soft); }
  .has-collage .cover { background:linear-gradient(145deg,var(--color-accent-light),#f6eed5); }
  .has-collage .cover :global(img) { object-fit:contain; padding:1rem; }
  .project-card:hover .cover :global(img) { transform:translateY(-4px) scale(1.025); }
  .is-highlight .cover { order:2; aspect-ratio:auto; min-height:100%; }
  .content { padding:1.35rem; }
  .is-highlight .content { display:flex; flex-direction:column; justify-content:center; padding:clamp(1.6rem,4vw,3.2rem); }
  .meta { display:flex; justify-content:space-between; margin-bottom:.45rem; color:var(--color-text-secondary); font-size:.78rem; font-weight:700; }
  .content h3 a { position:relative; display:inline-flex; gap:.45rem; color:var(--color-text-primary); text-decoration:none; }
  .content h3 a::after { content:""; position:absolute; left:0; right:1.5rem; bottom:-.18rem; height:3px; background:var(--color-accent); transform:scaleX(0) rotate(-1deg); transform-origin:left; transition:transform var(--motion-normal) var(--ease-spring-soft); }
  .project-card:hover h3 a::after { transform:scaleX(1) rotate(-1deg); }
  .project-arrow { transition:transform var(--motion-fast); }
  .project-card:hover .project-arrow { transform:translate(3px,-3px); }
  .content p { color:var(--color-text-secondary); }
  .tags,.quick-links { display:flex; gap:.4rem; flex-wrap:wrap; }
  .quick-links { position:relative; z-index:2; margin-top:1.1rem; }
  .quick-links a { font-size:.82rem; font-weight:750; }
  @media (max-width:700px) { .project-card,.project-card.is-highlight { grid-column:1/-1; display:block; min-height:0; } .is-highlight .cover { min-height:250px; } .is-highlight .content { padding:1.35rem; } }
  @media (prefers-reduced-motion:reduce) { .project-card:hover,.project-card:hover .cover :global(img) { transform:none; } }
</style>
