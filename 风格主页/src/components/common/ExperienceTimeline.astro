---
import type { Experience, Locale } from "@/types";
import { local } from "@/i18n";
const { items, locale } = Astro.props as { items: Experience[]; locale: Locale };
---
<div class="timeline">
  <svg class="journey-path reveal-on-scroll" viewBox="0 0 80 600" preserveAspectRatio="none" aria-hidden="true">
    <path d="M42 4 C8 90 72 140 38 220 S66 360 36 445 S56 545 40 596" />
    <path class="arrow" d="M30 580 L40 596 L52 580" />
  </svg>
  {items.map((item, index) => (
    <article class="timeline-item reveal-on-scroll" style={`--reveal-delay:${index * 90}ms`}>
      <div class="node" aria-hidden="true"><span>{String(index + 1).padStart(2,"0")}</span></div>
      <div class="time"><span>{item.period}</span></div>
      <div class="card body">
        <p class="eyebrow">{item.category}</p>
        <h3>{local(item.role, locale)} · {local(item.organization, locale)}</h3>
        <p class="where">{local(item.location, locale)}</p>
        <p>{local(item.context, locale)}</p>
        <ul>{item.achievements.map((a) => <li>{local(a, locale)}</li>)}</ul>
        <div class="tags">{item.skills.map((skill) => <span class="tag">{skill}</span>)}</div>
      </div>
    </article>
  ))}
</div>
<style>
  .timeline { position:relative; }
  .journey-path { position:absolute; left:132px; top:0; width:42px; height:100%; overflow:visible; opacity:.72; }
  .journey-path path { fill:none; stroke:var(--color-accent); stroke-width:2; stroke-linecap:round; stroke-dasharray:900; stroke-dashoffset:900; transition:stroke-dashoffset 1.8s var(--ease-standard); }
  .journey-path.is-visible path { stroke-dashoffset:0; }
  .journey-path .arrow { stroke-width:2.4; }
  .timeline-item { position:relative; display:grid; grid-template-columns:130px 1fr; gap:3rem; margin-bottom:1.5rem; }
  .node { position:absolute; z-index:2; left:140px; top:1.2rem; display:grid; place-items:center; width:28px; height:28px; border:4px solid var(--color-background); border-radius:46% 54% 48% 52%; background:var(--color-accent); color:#fff; transform:rotate(-4deg); }
  .node span { font-size:.58rem; font-weight:850; }
  .time { padding-top:1.25rem; }
  .time span { display:inline-block; padding:.2rem .55rem; background:#f3e4bb; color:#4b4a38; font-size:.8rem; font-weight:800; transform:rotate(-1.5deg); }
  .body { padding:1.35rem; }
  .where { color:var(--color-text-secondary); font-size:.9rem; }
  .body ul { padding-left:1.2rem; }
  .tags { display:flex; gap:.4rem; flex-wrap:wrap; }
  [data-theme="dark"] .node { border-color:var(--color-background); }
  @media(max-width:700px){.journey-path{left:-11px;width:32px}.timeline-item{grid-template-columns:1fr;gap:.4rem;padding-left:1.7rem}.node{left:-10px;top:0;width:24px;height:24px}.time{padding-top:0}.body{padding:1.1rem}}
  @media(prefers-reduced-motion:reduce){.journey-path path{stroke-dashoffset:0}}
</style>
