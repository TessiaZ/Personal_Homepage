---
import { profile } from "@/data/profile";
import { siteConfig } from "@/config/site";
import type { Locale } from "@/types";
interface Props {
  title: string;
  description: string;
  locale: Locale;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}
const {
  title,
  description,
  locale,
  image = "/images/og.svg",
  type = "website",
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl);
const absoluteImage = new URL(
  `${import.meta.env.BASE_URL}${image.replace(/^\//, "")}`,
  Astro.site ?? siteConfig.siteUrl,
);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: locale === "zh" ? profile.nameZh : profile.nameEn,
  url: canonical.origin,
  email: `mailto:${profile.email}`,
  sameAs: [
    profile.github,
    profile.linkedin,
    profile.scholar,
    profile.orcid,
  ].filter(Boolean),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(jsonLd ?? person)}
/>
