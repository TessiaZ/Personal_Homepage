---
import type { Locale, Project } from "@/types";
import { local, localePath } from "@/i18n";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CollageImage from "@/components/visual/CollageImage.astro";
import ImageReveal from "@/components/visual/ImageReveal.astro";
import { projectDetailVisuals, visualAssets } from "@/data/visualAssets";
const { locale, project } = Astro.props as { locale: Locale; project: Project };
const zh = locale === "zh";
const detailVisualKey = projectDetailVisuals[project.slug];
const detailVisual = detailVisualKey ? visualAssets[detailVisualKey] : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: local(project.title, locale),
  description: local(project.summary, locale),
  dateCreated: String(project.year),
  author: { "@type": "Person", name: zh ? profile.nameZh : profile.nameEn },
};
---

<BaseLayout
  {locale}
  title={`${local(project.title, locale)} · ${zh ? profile.nameZh : profile.nameEn}`}
  description={local(project.summary, locale)}
  image={project.cover}
  {jsonLd}
  ><article>
    <header class="detail-hero">
      <div class="container">
        <a href={localePath(locale, "projects")}
          >← {zh ? "返回项目" : "Back to projects"}</a
        ><div class="meta">
          <span class="tag">{project.type}</span><span>{project.year}</span
          ><span>{local(project.role, locale)}</span>
        </div><h1>{local(project.title, locale)}</h1><p class="lede">
          {local(project.description, locale)}
        </p><div class="tags">
          {project.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
    </header><div class:list={["container", "detail-cover", detailVisual?.transparent && "transparent-cover"]}>
      {detailVisual ? <ImageReveal><CollageImage asset={detailVisual} {locale} priority widths={[720,1080,1440]} sizes="(max-width:1160px) 94vw, 1160px" /></ImageReveal> : <img src={`${import.meta.env.BASE_URL}${project.cover.replace(/^\//, "")}`} width="1200" height="700" alt={local(project.title, locale)} />}
    </div><div class="narrow section prose">
      {
        project.sections.map((section) => (
          <section>
            <>
              <h2>{local(section.title, locale)}</h2>
              <p>{local(section.body, locale)}</p>
            </>
          </section>
        ))
      }<section>
        <h2>{zh ? "相关链接" : "Links"}</h2><div class="links">
          {
            Object.entries(project.links).map(
              ([label, url]) =>
                url && (
                  <a class="button button-secondary" href={url}>
                    {label} ↗
                  </a>
                ),
            )
          }
        </div>
      </section>
    </div>
  </article></BaseLayout
>
<style>
  .detail-hero {
    padding: 4rem 0 3rem;
  }
  .detail-hero a {
    display: inline-block;
    margin-bottom: 2rem;
  }
  .detail-hero h1 {
    max-width: 15ch;
    margin: 0.8rem 0;
  }
  .meta,
  .tags,
  .links {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .meta {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }
  .detail-cover {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-muted);
  }
  .detail-cover img {
    width: 100%;
    max-height: 600px;
    object-fit: cover;
  }
  .transparent-cover { background:linear-gradient(145deg,var(--color-accent-light),#f5edd7); }
  .transparent-cover :global(img) { object-fit:contain; padding:clamp(1rem,4vw,3rem); }
  .links {
    margin-top: 1rem;
  }
</style>
