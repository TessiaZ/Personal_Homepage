---
import type { Locale } from "@/types";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/common/PageHeader.astro";
import SocialLinks from "@/components/common/SocialLinks.astro";
const { locale } = Astro.props as { locale: Locale };
const zh = locale === "zh";
---

<BaseLayout
  {locale}
  title={`${zh ? "联系" : "Contact"} · ${zh ? profile.nameZh : profile.nameEn}`}
  description={zh
    ? "科研合作、实习机会、开源项目与 AI 应用交流。"
    : "Research collaboration, internships, open-source projects, and AI discussions."}
  ><PageHeader
    eyebrow="Contact"
    title={zh ? "很高兴认识你" : "It would be good to meet"}
    description={zh
      ? "欢迎就科研合作、实习机会、开源项目和人工智能应用进行交流。"
      : "I am open to research collaboration, internship opportunities, open-source projects, and discussions about AI applications."}
  /><section class="section">
    <div class="container contact-grid">
      <article>
        <p class="eyebrow">Email</p><h2>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </h2><p class="lede">
          {
            zh
              ? "邮件是最可靠的联系方式。我通常会在 2—3 个工作日内回复。"
              : "Email is the most reliable way to reach me. I usually reply within two or three working days."
          }
        </p>
      </article><aside><SocialLinks /></aside>
    </div>
  </section></BaseLayout
>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .contact-grid h2 {
    overflow-wrap: anywhere;
  }
  .contact-grid h2 a {
    color: var(--color-text-primary);
  }
  @media (max-width: 760px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
