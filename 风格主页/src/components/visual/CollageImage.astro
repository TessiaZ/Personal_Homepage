---
import type { VisualAsset } from "@/data/visualAssets";

interface Props {
  asset: VisualAsset;
  locale?: "zh" | "en";
  class?: string;
  priority?: boolean;
  animation?: "none" | "float" | "parallax" | "reveal";
  decorative?: boolean;
  widths?: number[];
  sizes?: string;
}
const {
  asset,
  locale = "zh",
  class: className,
  priority = false,
  animation = asset.animationPreset === "drift" || asset.animationPreset === "rotate" ? "none" : asset.animationPreset,
  decorative = false,
  sizes = "(max-width: 767px) 92vw, 50vw",
} = Astro.props;
const alt = decorative ? "" : locale === "zh" ? asset.altZh : asset.altEn;
---
<img
  src={`${import.meta.env.BASE_URL}${asset.src.replace(/^\//, "")}`}
  width={asset.width}
  height={asset.height}
  {alt}
  {sizes}
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={priority ? "high" : "auto"}
  class:list={["collage-image",asset.transparent&&"is-transparent",`motion-${animation}`,decorative&&"is-decorative",className]}
  aria-hidden={decorative ? "true" : undefined}
/>
<style>
  .collage-image { width:100%; height:auto; }
  .is-transparent { filter:drop-shadow(0 18px 28px rgba(23,79,64,.12)); }
  .is-decorative { pointer-events:none; user-select:none; }
  .motion-float { animation:float-soft 7.8s var(--ease-standard) infinite alternate; }
  [data-theme="dark"] .is-transparent { filter:drop-shadow(0 18px 26px rgba(0,0,0,.14)); }
</style>
